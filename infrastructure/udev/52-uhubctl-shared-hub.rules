# Grants the plugdev group control access to the VIA Labs VL812 hub on this
# host, so uhubctl can power-cycle its ports without root. The VL812 is a
# USB3 hub: it enumerates as two hubs, a USB2 half (2109:2812, 3-11.2) and
# a USB3 half (2109:0812, 4-1.2), and a port's VBUS only really goes off
# when BOTH halves switch it off. With access to the USB2 half alone,
# `uhubctl -a off` was only a logical disconnect -- VBUS stayed on.
#
# Port 1: VisionCB-8M-STD's SEGGER J-Link probe (recovered when it drops
# off the bus or wedges -- see run_visioncb_hil.py's recover_probe()).
# Port 3: NUCLEO-F446RE's ST-LINK, whose USB power is the whole board's
# power (see run_nucleo_hil.py).
SUBSYSTEM=="usb", ATTR{idVendor}=="2109", ATTR{idProduct}=="2812", MODE="0664", GROUP="plugdev"
SUBSYSTEM=="usb", ATTR{idVendor}=="2109", ATTR{idProduct}=="0812", MODE="0664", GROUP="plugdev"
